<Project>

	<!-- Choose the SDK before its default properties are imported. -->
	<PropertyGroup>
		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
		<TmlTargetsPath Condition="'$(TmlTargetsPath)' == ''">..\tModLoader.targets</TmlTargetsPath>
		<PublicizerVersion Condition="'$(PublicizerVersion)' == ''">2.3.0</PublicizerVersion>
	</PropertyGroup>
	<Import Project="Sdk.props" Sdk="Tomat.Terraria.ModLoader.Sdk" Version="2.1.1" Condition="'$(Configuration)' == 'Debug'" />
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(Configuration)' != 'Debug'" />
	<Import Project="$(TmlTargetsPath)" Condition="'$(Configuration)' != 'Debug'" />

	<PropertyGroup>
		<TmlVersion>steam</TmlVersion>
		<TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<AssemblyName>PvPAdventure</AssemblyName>
		<LangVersion>latest</LangVersion>
		<!-- tModLoader dependency packaging writes shared files and cannot run concurrently. -->
		<BuildInParallel>false</BuildInParallel>
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>

	<!-- Tomat supplies these in Debug; the standard build needs them explicitly. -->
	<ItemGroup Condition="'$(Configuration)' != 'Debug'">
		<PackageReference Include="Krafs.Publicizer" Version="$(PublicizerVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
		<Publicize Include="tModLoader" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
	</ItemGroup>

	<Import Project="Sdk.targets" Sdk="Tomat.Terraria.ModLoader.Sdk" Version="2.1.1" Condition="'$(Configuration)' == 'Debug'" />
	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(Configuration)' != 'Debug'" />

	<!-- Test sources and their generated assembly attributes belong to their own projects. -->
	<ItemGroup>
		<Compile Remove="Tests/**/*.cs" />
	</ItemGroup>
</Project>
